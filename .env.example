# 공공데이터포털에서 발급된 일반 인증키
# 실제 값은 .env.local에만 저장하고 Git에 커밋하지 않습니다.
TOUR_API_KEY=

# (선택) 기상청 단기예보 API 인증키.
# 비워두면 TOUR_API_KEY 로 시도합니다 (같은 공공데이터포털 계정에서
# 기상청 단기예보 조회서비스를 활용신청한 경우 동일 키가 동작).
# 미신청·실패 시 기상은 "확인 불가"로 표기되고 판정에 반영되지 않습니다.
KMA_API_KEY=

# ── 로그인 (AX-219 · ADR-0004) ──
# 세션 서명 키. 32자 이상이어야 하며, 없으면 로그인 자체가 비활성화됩니다.
#   생성: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SAFEHOUR_SESSION_SECRET=

# 콜백 주소 조립용 배포 도메인 (예: https://safehour.vercel.app).
# 요청 헤더가 아니라 이 값으로 redirect_uri 를 만듭니다 — 호스트 헤더 주입 방지.
SAFEHOUR_BASE_URL=

# Google OAuth — 승인된 리디렉션 URI 에 <SAFEHOUR_BASE_URL>/api/auth/callback 등록
# 요청 범위는 openid 뿐입니다 (이메일·프로필 미수집).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 카카오 로그인 — Redirect URI 에 <SAFEHOUR_BASE_URL>/api/auth/callback 등록
# 선택 동의 항목을 요청하지 않습니다 (회원번호만 사용).
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 로그인 없이 전체 흐름을 볼 수 있는 데모 경로. 심사 시연용이며 "1" 일 때만 켜집니다.
# 운영에서 켜면 인증이 무의미해집니다.
SAFEHOUR_ALLOW_DEMO_LOGIN=
