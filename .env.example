# 공공데이터포털에서 발급된 일반 인증키
# 실제 값은 .env.local에만 저장하고 Git에 커밋하지 않습니다.
TOUR_API_KEY=

# (선택) 기상청 단기예보 API 인증키.
# 비워두면 TOUR_API_KEY 로 시도합니다 (같은 공공데이터포털 계정에서
# 기상청 단기예보 조회서비스를 활용신청한 경우 동일 키가 동작).
# 공백만 넣거나(예: KMA_API_KEY=' ') 'off' 로 두면 기상 조회를 끕니다 — TOUR_API_KEY 로 대신 시도하지 않습니다.
#   E2E 는 이 방법(' ')으로 외부 호출을 막습니다 (src/adapters/weather.js resolveKmaServiceKey).
# 미신청·실패·끔일 때 기상은 "확인 불가"로 표기되고 판정에 반영되지 않습니다.
KMA_API_KEY=

# (선택) 관광공사 API 호출 경고·차단 값 — operation 별 하루 호출 수 (spec 4.21 · src/tour-api/config.js)
# 비워두면 경고 800 · 차단 1,000 입니다. 양의 정수가 아니면 기본값으로 돌아가고,
# 경고 값이 차단 값보다 크면 차단 값으로 맞춥니다. 운영 계정 한도를 확인한 뒤 정합니다.
TOUR_API_WARNING_AT=
TOUR_API_DAILY_LIMIT=

# ── 로그인 (AX-219 · ADR-0004) ──
# 세션 서명 키. 32자 이상이어야 하며, 없으면 로그인 자체가 비활성화됩니다.
#   생성: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SAFEHOUR_SESSION_SECRET=

# 콜백 주소 조립용 배포 도메인 (예: https://safehour.vercel.app).
# 요청 헤더가 아니라 이 값으로 redirect_uri 를 만듭니다 — 호스트 헤더 주입 방지.
SAFEHOUR_BASE_URL=

# Google OAuth — 승인된 리디렉션 URI 에 <SAFEHOUR_BASE_URL>/api/auth/callback 등록
# 요청 범위는 openid 뿐입니다 (이메일·프로필 미수집).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 카카오 로그인 — Redirect URI 에 <SAFEHOUR_BASE_URL>/api/auth/callback 등록
# 선택 동의 항목을 요청하지 않습니다 (회원번호만 사용).
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 로그인 없이 전체 흐름을 볼 수 있는 데모 경로. 심사 시연용이며 "1" 일 때만 켜집니다.
# 운영에서 켜면 인증이 무의미해집니다.
SAFEHOUR_ALLOW_DEMO_LOGIN=

# ── 서버가 파일을 쓸 경로 (spec 4.21 · src/tour-api/config.js) ──
# 관광공사 호출 카운터·로그·응답 캐시를 이 경로 아래에 씁니다. 비워두면 프로젝트 루트입니다.
# 로컬에서는 비워둬도 되지만, 파일시스템이 읽기 전용인 서버리스 배포에서는 **필수**입니다 —
# 쓰기 가능한 경로(예: /tmp/safehour)가 없으면 모듈을 읽는 시점에 실패해 모든 API 가 500 이 됩니다.
SAFEHOUR_DATA_ROOT=

# ── 추천 전면 중단 스위치 (spec 4.21 · lib/server/runtime-flags.js) ──
# 위험 추천이 발견됐을 때 배포를 기다리지 않고 즉시 막는 스위치입니다.
# 기능을 **끄는** 스위치라 느슨하게 읽습니다 — '1'·'true'·'on'(대소문자·앞뒤 공백 무시)이면 켜집니다.
# 켜지면 모든 날짜가 정거장 0건 NO_TOURISM + SERVICE_PAUSED 로 응답합니다.
# 긴급 연락·한국어 카드·조건 화면은 계속 동작합니다.
SAFEHOUR_KILL_RECOMMENDATION=

# ── 도로명주소 검색 (AX-310 · spec 6장 POST /api/address/search) ──
# 행정안전부 도로명주소 검색 API 키와 좌표제공 API 키. 두 키가 모두 있어야 주소 검색이 켜집니다.
# 하나라도 없으면 /api/address/search 가 503 SAFEHOUR_ADDRESS_UNAVAILABLE 을 돌려줍니다
# (데모 로그인 모드에서는 '데모 주소' 고정 목록을 돌려줍니다). 키는 서버에서만 씁니다.
JUSO_API_KEY=
JUSO_COORD_API_KEY=

# ── AI 일정 소개 문장 (AX-309 · spec 4.16 · ADR-0008) — 기본 꺼짐 ──
# 스위치: 정확히 '1' 일 때만 켜집니다('true'·'on' 은 꺼짐). 사용 승인(docs/platform/AI_USE_CASE_INTRO.md) 전에는 켜지 않습니다.
# 스위치가 켜져 있어도 GEMINI_API_KEY 가 없으면 정해진 문장(TEMPLATE)만 씁니다.
SAFEHOUR_AI_INTRO=
# Gemini API 키 — 서버에서 x-goog-api-key 헤더로만 보냅니다(URL 에 넣지 않음).
GEMINI_API_KEY=
# (선택) 모델 이름. 비워두면 lib/server/ai-intro.js 의 기본 모델(Flash-Lite 등급)을 씁니다.
# 모델을 바꾸면 평가(npm run ai:eval)를 다시 돌립니다.
GEMINI_MODEL=

# ── 일본어·중국어 안전 문구 검수 스위치 (AX-303 · spec 4.17 · 규칙 43) ──
# 빌드 때 번들에 새겨지는 공개 값입니다 — 바꾸면 다시 빌드해야 합니다. 정확히 '1' 일 때만 켜집니다.
# 꺼져 있으면 ja·zh 사용자의 안전 문구는 영어 + 한국어로 보입니다. 사람 검수가 끝난 언어만 '1' 로 둡니다.
NEXT_PUBLIC_SAFEHOUR_SAFETY_COPY_REVIEWED_JA=
NEXT_PUBLIC_SAFEHOUR_SAFETY_COPY_REVIEWED_ZH=

# ── 서버 알림: 보호자 푸시 (ADR-0012 · lib/server/watch/config.js) ── 기본 꺼짐
# 켜는 스위치: 정확히 '1' 일 때만 켜집니다('true'·'on'·' 1' 은 꺼짐).
# 켜져 있어도 아래 필수 값이 하나라도 없거나 형식이 틀리면 동작하지 않습니다(/api/watch* 쓰기 경로가 503 SAFEHOUR_SERVER_PUSH_OFF).
# 무엇이 빠졌는지는 /api/health 의 config.serverPushReady·serverPushMissing 에 이름으로만 나옵니다(값은 나오지 않음).
SAFEHOUR_SERVER_PUSH=
# 끄는 스위치: 사고 때 즉시 멈추는 용도라 느슨하게 읽습니다. '1'·'true'·'on'(대소문자·앞뒤 공백 무시)이면 켜집니다.
# 켜지면 쓰기 경로는 503 이 되고, 지우기 경로(DELETE /api/watch, DELETE /api/watch/subscribe)만 계속 동작합니다.
SAFEHOUR_KILL_SERVER_PUSH=

# 비밀 값 다섯 개(VAPID 키 쌍, 봉인 키, 소유 비밀, CRON_SECRET)는 아래 명령으로 만듭니다.
#   node scripts/generate-push-secrets.mjs
# 운영과 미리보기에 서로 다른 값을 쓰고, 출력은 비밀번호 관리자에만 옮깁니다. 저장소에 커밋하지 않습니다.

# (필수) 저장소: Upstash Redis REST 주소(https 만)와 토큰.
# 이 이름이 없으면 Vercel 연동이 넣는 KV_REST_API_URL·KV_REST_API_TOKEN 을 읽습니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# (필수) 예약: QStash 토큰과 서명 키 둘. 하나라도 없으면 준비되지 않은 것으로 봅니다.
# QSTASH_URL 은 선택이며 비워두면 https://qstash.upstash.io 를 씁니다(https 만).
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# (필수) VAPID: 공개키는 base64url 로 65바이트(첫 바이트 0x04), 개인키는 32바이트입니다.
# SUBJECT 는 mailto: 또는 https: 주소입니다(예: mailto:ops@example.com).
SAFEHOUR_VAPID_PUBLIC_KEY=
SAFEHOUR_VAPID_PRIVATE_KEY=
SAFEHOUR_VAPID_SUBJECT=

# (필수) 구독 봉인 키: base64url 로 정확히 32바이트. 저장한 푸시 구독을 AES-256-GCM 으로 감쌉니다.
# 키를 바꿀 때는 옛 키를 _PREVIOUS 에 잠시 두면 기존 구독을 계속 풉니다(선택, 형식이 틀리면 무시).
SAFEHOUR_PUSH_STORE_KEY=
SAFEHOUR_PUSH_STORE_KEY_PREVIOUS=

# (필수) 지켜보기를 찾는 키를 만드는 비밀, 32자 이상. 세션 서명 키와 다른 값을 씁니다.
# 바꾸면 기존 지켜보기를 더는 찾지 못하고 만료로 사라집니다(환자가 다시 켜야 함).
SAFEHOUR_WATCH_OWNER_SECRET=

# (필수) 예약 처리 경로와 하루 1회 예약 경로를 부를 때 쓰는 Bearer 비밀, 16자 이상.
CRON_SECRET=

# (선택) 예약 업체가 되부를 주소의 앞부분(끝 슬래시 없이). https 만 받습니다(데모 로그인일 때는 http://localhost·http://127.0.0.1 도).
# 비워두면 운영은 https:// + VERCEL_PROJECT_PRODUCTION_URL, 미리보기는 https:// + VERCEL_BRANCH_URL(없으면 VERCEL_URL)을 씁니다.
# 값을 넣었는데 형식이 틀리면 Vercel 주소로 넘어가지 않고 빠진 값으로 알립니다.
# VERCEL_ENV·VERCEL_URL·VERCEL_BRANCH_URL·VERCEL_PROJECT_PRODUCTION_URL·VERCEL_AUTOMATION_BYPASS_SECRET 은
# Vercel 이 넣는 시스템 값이라 직접 적지 않습니다. 저장 키 이름공간은 VERCEL_ENV 로 나뉩니다(운영·미리보기·그 밖).
# 미리보기에 배포 보호가 켜져 있으면 VERCEL_AUTOMATION_BYPASS_SECRET 으로 예약 업체의 되부르기를 통과시킵니다.
SAFEHOUR_PUBLIC_BASE_URL=

# (선택) '1' 이면 보호자가 로그인하지 않고 알림 받기 등록·상태 조회·'오늘 함께 있음'을 쓸 수 있습니다.
# 비워두면 보호자도 로그인해야 합니다(알림 끊기는 어느 쪽이든 로그인 없이 됩니다).
SAFEHOUR_WATCH_GUARDIAN_NO_LOGIN=

# (데모 전용) 아래 둘은 SAFEHOUR_ALLOW_DEMO_LOGIN=1 일 때만 듣습니다. 그 밖에는 무시합니다.
# SAFEHOUR_STORE_MODE=memory 면 Upstash 값이 있어도 메모리 저장소를 쓰고, QStash 와 되부를 주소 없이도 준비됩니다.
SAFEHOUR_STORE_MODE=
# 시험용 가짜 푸시 서비스 출처(예: http://127.0.0.1:4010). 화면 테스트에서만 씁니다.
SAFEHOUR_PUSH_TEST_ORIGIN=
