# 공공데이터포털에서 발급된 일반 인증키
# 실제 값은 .env.local에만 저장하고 Git에 커밋하지 않습니다.
TOUR_API_KEY=

# (선택) 기상청 단기예보 API 인증키.
# 비워두면 TOUR_API_KEY 로 시도합니다 (같은 공공데이터포털 계정에서
# 기상청 단기예보 조회서비스를 활용신청한 경우 동일 키가 동작).
# 공백만 넣거나(예: KMA_API_KEY=' ') 'off' 로 두면 기상 조회를 끕니다 — TOUR_API_KEY 로 대신 시도하지 않습니다.
#   E2E 는 이 방법(' ')으로 외부 호출을 막습니다 (src/adapters/weather.js resolveKmaServiceKey).
# 미신청·실패·끔일 때 기상은 "확인 불가"로 표기되고 판정에 반영되지 않습니다.
KMA_API_KEY=

# (선택) 관광공사 API 호출 경고·차단 값 — operation 별 하루 호출 수 (spec 4.21 · src/tour-api/config.js)
# 비워두면 경고 800 · 차단 1,000 입니다. 양의 정수가 아니면 기본값으로 돌아가고,
# 경고 값이 차단 값보다 크면 차단 값으로 맞춥니다. 운영 계정 한도를 확인한 뒤 정합니다.
TOUR_API_WARNING_AT=
TOUR_API_DAILY_LIMIT=

# ── 로그인 (AX-219 · ADR-0004) ──
# 세션 서명 키. 32자 이상이어야 하며, 없으면 로그인 자체가 비활성화됩니다.
#   생성: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SAFEHOUR_SESSION_SECRET=

# 콜백 주소 조립용 배포 도메인 (예: https://safehour.vercel.app).
# 요청 헤더가 아니라 이 값으로 redirect_uri 를 만듭니다 — 호스트 헤더 주입 방지.
SAFEHOUR_BASE_URL=

# Google OAuth — 승인된 리디렉션 URI 에 <SAFEHOUR_BASE_URL>/api/auth/callback 등록
# 요청 범위는 openid 뿐입니다 (이메일·프로필 미수집).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 카카오 로그인 — Redirect URI 에 <SAFEHOUR_BASE_URL>/api/auth/callback 등록
# 선택 동의 항목을 요청하지 않습니다 (회원번호만 사용).
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 로그인 없이 전체 흐름을 볼 수 있는 데모 경로. 심사 시연용이며 "1" 일 때만 켜집니다.
# 운영에서 켜면 인증이 무의미해집니다.
SAFEHOUR_ALLOW_DEMO_LOGIN=

# ── 서버가 파일을 쓸 경로 (spec 4.21 · src/tour-api/config.js) ──
# 관광공사 호출 카운터·로그·응답 캐시를 이 경로 아래에 씁니다. 비워두면 프로젝트 루트입니다.
# 로컬에서는 비워둬도 되지만, 파일시스템이 읽기 전용인 서버리스 배포에서는 **필수**입니다 —
# 쓰기 가능한 경로(예: /tmp/safehour)가 없으면 모듈을 읽는 시점에 실패해 모든 API 가 500 이 됩니다.
SAFEHOUR_DATA_ROOT=

# ── 추천 전면 중단 스위치 (spec 4.21 · lib/server/runtime-flags.js) ──
# 위험 추천이 발견됐을 때 배포를 기다리지 않고 즉시 막는 스위치입니다.
# 기능을 **끄는** 스위치라 느슨하게 읽습니다 — '1'·'true'·'on'(대소문자·앞뒤 공백 무시)이면 켜집니다.
# 켜지면 모든 날짜가 정거장 0건 NO_TOURISM + SERVICE_PAUSED 로 응답합니다.
# 긴급 연락·한국어 카드·조건 화면은 계속 동작합니다.
SAFEHOUR_KILL_RECOMMENDATION=

# ── 도로명주소 검색 (AX-310 · spec 6장 POST /api/address/search) ──
# 행정안전부 도로명주소 검색 API 키와 좌표제공 API 키. 두 키가 모두 있어야 주소 검색이 켜집니다.
# 하나라도 없으면 /api/address/search 가 503 SAFEHOUR_ADDRESS_UNAVAILABLE 을 돌려줍니다
# (데모 로그인 모드에서는 '데모 주소' 고정 목록을 돌려줍니다). 키는 서버에서만 씁니다.
JUSO_API_KEY=
JUSO_COORD_API_KEY=

# ── AI 일정 소개 문장 (AX-309 · spec 4.16 · ADR-0008) — 기본 꺼짐 ──
# 스위치: 정확히 '1' 일 때만 켜집니다('true'·'on' 은 꺼짐). 사용 승인(docs/platform/AI_USE_CASE_INTRO.md) 전에는 켜지 않습니다.
# 스위치가 켜져 있어도 GEMINI_API_KEY 가 없으면 정해진 문장(TEMPLATE)만 씁니다.
SAFEHOUR_AI_INTRO=
# Gemini API 키 — 서버에서 x-goog-api-key 헤더로만 보냅니다(URL 에 넣지 않음).
GEMINI_API_KEY=
# (선택) 모델 이름. 비워두면 lib/server/ai-intro.js 의 기본 모델(Flash-Lite 등급)을 씁니다.
# 모델을 바꾸면 평가(npm run ai:eval)를 다시 돌립니다.
GEMINI_MODEL=

# ── 일본어·중국어 안전 문구 검수 스위치 (AX-303 · spec 4.17 · 규칙 43) ──
# 빌드 때 번들에 새겨지는 공개 값입니다 — 바꾸면 다시 빌드해야 합니다. 정확히 '1' 일 때만 켜집니다.
# 꺼져 있으면 ja·zh 사용자의 안전 문구는 영어 + 한국어로 보입니다. 사람 검수가 끝난 언어만 '1' 로 둡니다.
NEXT_PUBLIC_SAFEHOUR_SAFETY_COPY_REVIEWED_JA=
NEXT_PUBLIC_SAFEHOUR_SAFETY_COPY_REVIEWED_ZH=
